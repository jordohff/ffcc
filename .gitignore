# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Pulled/cached data and generated outputs (regenerated by scripts, not committed)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
output/projections/*
!output/projections/.gitkeep
output/draft_rankings/*
!output/draft_rankings/.gitkeep

# Paid third-party data (FantasyPoints, etc.) - kept local only, not
# committed, since redistributing someone else's licensed data isn't ours
# to do even in a private repo. Drop downloaded CSVs in data/paid/.
data/paid/*
!data/paid/.gitkeep
